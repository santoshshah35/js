rules_version = '2';

// Contact sync (ui/contacts.js). members/{code}: one document per number
// that uses Patro, named by its one-way code, holding the anonymous user
// who registered it. Anyone signed in may check a code they already have;
// nobody may list the collection, so the codes can't be downloaded.
service cloud.firestore {
  match /databases/{database}/documents {
    match /members/{code} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
        && code.matches('^[0-9a-f]{64}$')
        && request.resource.data.keys().hasOnly(['uid', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.at is timestamp;
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.at is timestamp;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
